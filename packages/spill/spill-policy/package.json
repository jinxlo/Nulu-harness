{
  "name": "@worldapptechnologies/nulu-spill-policy",
  "description": "Tool-result spill policy for the Nulu Harness — replaces oversized plain-text tool results with a retained preview plus a spill-file path (no service API)",
  "version": "0.1.6-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldapptechnologies/nulu-harness.git",
    "directory": "packages/spill/spill-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./notice": {
      "types": "./lib/types/notice.d.ts",
      "default": "./lib/types/notice.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-output-retention": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-spill": "workspace:^",
    "@worldapptechnologies/nulu-tools": "workspace:^",
    "@worldapptechnologies/cordis": "workspace:^"
  },
  "dependencies": {
    "@worldapptechnologies/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@worldapptechnologies/nulu-agent": "workspace:^",
    "@worldapptechnologies/nulu-ptc-runtime-node": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-output-retention": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-spill": "workspace:^",
    "@worldapptechnologies/nulu-tools": "workspace:^",
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/nulu-fs-local": "workspace:^",
    "@worldapptechnologies/nulu-subprocess-local": "workspace:^",
    "@worldapptechnologies/nulu-sandbox-local": "workspace:^",
    "@worldapptechnologies/nulu-sandbox-policy": "workspace:^",
    "@worldapptechnologies/nulu-session-projection": "workspace:^"
  }
}
