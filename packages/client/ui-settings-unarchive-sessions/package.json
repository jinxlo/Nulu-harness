{
  "name": "@worldapptechnologies/nulu-client-ui-settings-unarchive-sessions",
  "description": "Archived-session settings page: the registry-global archive set with one Unarchive action per row",
  "version": "0.1.6-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldapptechnologies/nulu-harness.git",
    "directory": "packages/client/ui-settings-unarchive-sessions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "nulu": {
    "client": {
      "inject": [
        "@worldapptechnologies/nulu-client-locale",
        "@worldapptechnologies/nulu-client-ui-renderer",
        "@worldapptechnologies/nulu-client-ui-session",
        "@worldapptechnologies/nulu-client-ui-settings",
        "@worldapptechnologies/nulu-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@worldapptechnologies/cordis": "workspace:^"
  },
  "devDependencies": {
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/nulu-api-session-controller": "workspace:^",
    "@worldapptechnologies/nulu-api-workspace-controller": "workspace:^",
    "@worldapptechnologies/nulu-client-locale": "workspace:^",
    "@worldapptechnologies/nulu-client-test-runtime": "workspace:^",
    "@worldapptechnologies/nulu-client-ui-primitives": "workspace:^",
    "@worldapptechnologies/nulu-client-ui-renderer": "workspace:^",
    "@worldapptechnologies/nulu-client-ui-session": "workspace:^",
    "@worldapptechnologies/nulu-client-ui-settings": "workspace:^",
    "@worldapptechnologies/nulu-client-ui-slots": "workspace:^",
    "@worldapptechnologies/nulu-client-ui-workspace": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
