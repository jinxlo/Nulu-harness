{
  "name": "@worldapptechnologies/nulu-client-ui-jobs",
  "description": "Session-header background-job list: live registry state mirrored from session/jobs frames",
  "version": "1.6.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "nulu": {
    "client": {
      "inject": [
        "@worldapptechnologies/nulu-client-locale",
        "@worldapptechnologies/nulu-client-ui-conversation",
        "@worldapptechnologies/nulu-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldapptechnologies/nulu-harness.git",
    "directory": "packages/client/ui-jobs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@worldapptechnologies/cordis": "workspace:^"
  },
  "devDependencies": {
    "@worldapptechnologies/nulu-client-locale": "workspace:^",
    "@worldapptechnologies/nulu-client-test-runtime": "workspace:^",
    "@worldapptechnologies/nulu-client-ui-conversation": "workspace:^",
    "@worldapptechnologies/nulu-client-ui-primitives": "workspace:^",
    "@worldapptechnologies/nulu-client-ui-slots": "workspace:^",
    "@types/react": "~18.3.1",
    "@worldapptechnologies/cordis": "workspace:^",
    "react": "^18.2.0",
    "@worldapptechnologies/nulu-api-session-controller": "workspace:^",
    "@worldapptechnologies/nulu-client-ui-renderer": "workspace:^",
    "@worldapptechnologies/nulu-client-ui-session": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
