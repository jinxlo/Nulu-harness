{
  "name": "@worldapptechnologies/nulu-client-store",
  "description": "React-free observable and snapshot-store contracts with the shared Zustand/Immer engine",
  "version": "1.6.4",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "@worldapptechnologies/cordis": "workspace:^"
  },
  "devDependencies": {
    "@worldapptechnologies/cordis": "workspace:^",
    "zustand": "~4.4.7",
    "immer": "^10.1.1"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ]
}
