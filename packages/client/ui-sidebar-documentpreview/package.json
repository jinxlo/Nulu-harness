{
  "name": "@worldapptechnologies/nulu-client-ui-sidebar-documentpreview",
  "description": "Extensible document previews for Sidebar files: Markdown, highlighted code, images, PDF, HTML, and plain text",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldapptechnologies/nulu-harness.git",
    "directory": "packages/client/ui-sidebar-documentpreview"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "nulu": {
    "client": {
      "inject": [
        "@worldapptechnologies/nulu-api-gateway",
        "@worldapptechnologies/nulu-api-workspace-files",
        "@worldapptechnologies/nulu-client-ui-sidebar-right",
        "@worldapptechnologies/nulu-client-ui-session",
        "@worldapptechnologies/nulu-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@worldapptechnologies/cordis": "workspace:^"
  },
  "devDependencies": {
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/nulu-api-gateway": "workspace:^",
    "@worldapptechnologies/nulu-api-remotes": "workspace:^",
    "@worldapptechnologies/nulu-api-workspace-files": "workspace:^",
    "@worldapptechnologies/nulu-client-locale": "workspace:^",
    "@worldapptechnologies/nulu-client-resources": "workspace:^",
    "@worldapptechnologies/nulu-client-store": "workspace:^",
    "@worldapptechnologies/nulu-client-test-runtime": "workspace:^",
    "@worldapptechnologies/nulu-client-ui-dockkit": "workspace:^",
    "@worldapptechnologies/nulu-client-ui-primitives": "workspace:^",
    "@worldapptechnologies/nulu-client-ui-renderer": "workspace:^",
    "@worldapptechnologies/nulu-client-ui-session": "workspace:^",
    "@worldapptechnologies/nulu-client-ui-sidebar-right": "workspace:^",
    "@worldapptechnologies/nulu-client-ui-slots": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-util-workspace-path": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "^2.0.0",
    "pdfjs-dist": "6.3.289",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
