{
  "name": "@worldapptechnologies/nulu-tool-present",
  "description": "Explicit workspace file delivery declarations for the Nulu Harness",
  "version": "1.6.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldapptechnologies/nulu-harness.git",
    "directory": "packages/fs/tool-present"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@worldapptechnologies/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/nulu-agent": "workspace:^",
    "@worldapptechnologies/nulu-fs": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-session-projection": "workspace:^",
    "@worldapptechnologies/nulu-tools": "workspace:^"
  },
  "devDependencies": {
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/nulu-agent": "workspace:^",
    "@worldapptechnologies/nulu-fs": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-session-projection": "workspace:^",
    "@worldapptechnologies/nulu-tools": "workspace:^",
    "@worldapptechnologies/nulu-agent-loop": "workspace:^",
    "@worldapptechnologies/nulu-agent-loop-testkit": "workspace:^",
    "@worldapptechnologies/nulu-fs-local": "workspace:^",
    "@worldapptechnologies/nulu-system-prompt": "workspace:^",
    "@worldapptechnologies/nulu-scope": "workspace:^"
  }
}
