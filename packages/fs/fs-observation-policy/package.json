{
  "name": "@worldapptechnologies/nulu-fs-observation-policy",
  "description": "File-context policy plugin for the Nulu Harness — observed-state, read-before-edit, and version-guarded write/edit added over the ctx.fs provider seam through the fs/* event gate (no service API)",
  "version": "1.6.4",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@worldapptechnologies/nulu-fs": "workspace:^",
    "@worldapptechnologies/cordis": "workspace:^"
  },
  "devDependencies": {
    "@worldapptechnologies/nulu-fs": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/cordis": "workspace:^"
  }
}
