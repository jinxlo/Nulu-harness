{
  "name": "@worldapptechnologies/nulu-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldapptechnologies/nulu-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "nulu": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@worldapptechnologies/cordis-plugin-timer": "workspace:^",
    "@worldapptechnologies/nulu-agent": "workspace:^",
    "@worldapptechnologies/nulu-agent-loop": "workspace:^",
    "@worldapptechnologies/nulu-deepseek-llm-api-extensions": "workspace:^",
    "@worldapptechnologies/nulu-invariants": "workspace:^",
    "@worldapptechnologies/nulu-jobs-local": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-llm-deepseek": "workspace:^",
    "@worldapptechnologies/nulu-llm-retry": "workspace:^",
    "@worldapptechnologies/nulu-plugin-package-inventory-deepseek": "workspace:^",
    "@worldapptechnologies/nulu-sandbox-local": "workspace:^",
    "@worldapptechnologies/nulu-sandbox-policy": "workspace:^",
    "@worldapptechnologies/nulu-scope": "workspace:^",
    "@worldapptechnologies/nulu-sdk-app": "workspace:^",
    "@worldapptechnologies/nulu-sdk-jsonrpc-server": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-session-log-deepseek": "workspace:^",
    "@worldapptechnologies/nulu-session-persistence-jsonl": "workspace:^",
    "@worldapptechnologies/nulu-session-projection": "workspace:^",
    "@worldapptechnologies/nulu-session-title": "workspace:^",
    "@worldapptechnologies/nulu-subprocess-local": "workspace:^",
    "@worldapptechnologies/nulu-system-prompt": "workspace:^",
    "@worldapptechnologies/nulu-terminal": "workspace:^",
    "@worldapptechnologies/nulu-terminal-bash": "workspace:^",
    "@worldapptechnologies/nulu-tool-bash-persistent": "workspace:^",
    "@worldapptechnologies/nulu-tool-pwsh-persistent": "workspace:^",
    "@worldapptechnologies/nulu-tools": "workspace:^"
  },
  "peerDependencies": {
    "@worldapptechnologies/cordis": "workspace:^"
  },
  "devDependencies": {
    "@worldapptechnologies/cordis": "workspace:^"
  }
}
