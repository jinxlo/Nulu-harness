{
  "name": "@worldapptechnologies/nulu-tool-workflow",
  "description": "Model-facing workflow tool: run a JavaScript orchestration script over ctx.workflowEngine",
  "version": "1.6.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldapptechnologies/nulu-harness.git",
    "directory": "packages/workflow/tool-workflow"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@worldapptechnologies/nulu-agent": "workspace:^",
    "@worldapptechnologies/nulu-invariants": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-system-prompt": "workspace:^",
    "@worldapptechnologies/nulu-tools": "workspace:^",
    "@worldapptechnologies/nulu-workflow": "workspace:^",
    "@worldapptechnologies/cordis": "workspace:^"
  },
  "dependencies": {
    "@worldapptechnologies/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@worldapptechnologies/nulu-agent": "workspace:^",
    "@worldapptechnologies/nulu-invariants": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-subagent": "workspace:^",
    "@worldapptechnologies/nulu-system-prompt": "workspace:^",
    "@worldapptechnologies/nulu-tools": "workspace:^",
    "@worldapptechnologies/nulu-workflow": "workspace:^",
    "@worldapptechnologies/nulu-workflow-ptc": "workspace:^",
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/nulu-session-projection": "workspace:^"
  }
}
