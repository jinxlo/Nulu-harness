    "@worldapptechnologies/node-addon-system": "workspace:^",
    "@worldapptechnologies/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-sandbox": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^"
  }
