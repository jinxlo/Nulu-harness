{
  "name": "@worldapptechnologies/nulu-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.1.6-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldapptechnologies/nulu-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "nulu": {
    "client": {
      "inject": [
        "@worldapptechnologies/nulu-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@worldapptechnologies/nulu-deque": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-util-values": "workspace:^"
  },
  "peerDependencies": {
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/nulu-scope": "workspace:^"
  },
  "devDependencies": {
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/nulu-agent": "workspace:^",
    "@worldapptechnologies/nulu-agent-presets": "workspace:^",
    "@worldapptechnologies/nulu-api-gateway": "workspace:^",
    "@worldapptechnologies/nulu-api-settings-controller": "workspace:^",
    "@worldapptechnologies/nulu-api-workspace-controller": "workspace:^",
    "@worldapptechnologies/nulu-commands": "workspace:^",
    "@worldapptechnologies/nulu-cordis-host-runner": "workspace:^",
    "@worldapptechnologies/nulu-credentials": "workspace:^",
    "@worldapptechnologies/nulu-file-reference": "workspace:^",
    "@worldapptechnologies/nulu-goal": "workspace:^",
    "@worldapptechnologies/nulu-host-plugin-inventory": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-message-feedback": "workspace:^",
    "@worldapptechnologies/nulu-permission-presets": "workspace:^",
    "@worldapptechnologies/nulu-session-reference": "workspace:^",
    "@worldapptechnologies/nulu-settings": "workspace:^",
    "@worldapptechnologies/nulu-subagent": "workspace:^",
    "@worldapptechnologies/nulu-user-approval": "workspace:^",
    "@worldapptechnologies/nulu-user-questions": "workspace:^",
    "@worldapptechnologies/nulu-client-connection": "workspace:^",
    "@worldapptechnologies/nulu-client-file-upload": "workspace:^",
    "@worldapptechnologies/nulu-typert-protocol": "workspace:^",
    "@worldapptechnologies/nulu-scope": "workspace:^",
    "@worldapptechnologies/nulu-api-session-controller": "workspace:^",
    "@worldapptechnologies/nulu-api-workspace-files": "workspace:^",
    "zod": "^4.4.3",
    "@worldapptechnologies/nulu-command-feedback": "workspace:^",
    "@worldapptechnologies/nulu-api-terminal-controller": "workspace:^"
  }
}
