{
  "name": "@worldapptechnologies/nulu-session-telemetry-otel",
  "description": "OpenTelemetry backend for the Nulu Harness telemetry seam: hands captured session records to the OTel JS SDK's log pipeline",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldapptechnologies/nulu-harness.git",
    "directory": "packages/session/session-telemetry-otel"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/otlp-exporter-base": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@worldapptechnologies/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@worldapptechnologies/nulu-command-feedback": "workspace:^",
    "@worldapptechnologies/nulu-message-feedback": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-session-telemetry": "workspace:^",
    "@worldapptechnologies/nulu-anonymous-user-id": "workspace:^",
    "@worldapptechnologies/cordis": "workspace:^"
  },
  "devDependencies": {
    "@worldapptechnologies/cordis-plugin-logger-console": "workspace:^",
    "@worldapptechnologies/cordis-plugin-loader": "workspace:^",
    "@worldapptechnologies/nulu-app-boot": "workspace:^",
    "@worldapptechnologies/nulu-bash-local": "workspace:^",
    "@worldapptechnologies/nulu-command-feedback": "workspace:^",
    "@worldapptechnologies/nulu-message-feedback": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-loader-smoke": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-session-checkpoint-policy": "workspace:^",
    "@worldapptechnologies/nulu-session-persistence-jsonl": "workspace:^",
    "@worldapptechnologies/nulu-session-telemetry": "workspace:^",
    "@worldapptechnologies/nulu-subprocess-local": "workspace:^",
    "@worldapptechnologies/nulu-anonymous-user-id": "workspace:^",
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/nulu-http-proxy": "workspace:^"
  }
