{
  "name": "@worldapptechnologies/nulu-tools",
  "description": "Tool registry and execution pipeline for the Nulu Harness",
  "version": "0.1.6-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldapptechnologies/nulu-harness.git",
    "directory": "packages/core/tools"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./presentation": {
      "types": "./lib/types/presentation.d.ts",
      "default": "./lib/types/presentation.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/nulu-agent": "workspace:^",
    "@worldapptechnologies/nulu-ptc-runtime": "workspace:^",
    "@worldapptechnologies/nulu-invariants": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-scope": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-system-prompt": "workspace:^",
    "@worldapptechnologies/nulu-user-approval": "workspace:^",
    "@worldapptechnologies/nulu-sandbox": "workspace:^",
    "@worldapptechnologies/nulu-sandbox-policy": "workspace:^"
  },
  "dependencies": {
    "@worldapptechnologies/nulu-brand": "workspace:^",
    "@worldapptechnologies/nulu-util-values": "workspace:^",
    "@worldapptechnologies/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/nulu-agent": "workspace:^",
    "@worldapptechnologies/nulu-ptc-runtime": "workspace:^",
    "@worldapptechnologies/nulu-invariants": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-scope": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-session-projection": "workspace:^",
    "@worldapptechnologies/nulu-system-prompt": "workspace:^",
    "@worldapptechnologies/nulu-user-approval": "workspace:^",
    "@worldapptechnologies/nulu-sandbox": "workspace:^",
    "@worldapptechnologies/nulu-sandbox-policy": "workspace:^"
  }
}
