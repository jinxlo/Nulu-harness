{
  "name": "@worldapptechnologies/nulu-session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "1.6.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldapptechnologies/nulu-harness.git",
    "directory": "packages/context/session-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@worldapptechnologies/nulu-brand": "workspace:^",
    "@worldapptechnologies/nulu-util-values": "workspace:^",
    "@worldapptechnologies/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/nulu-agent": "workspace:^",
    "@worldapptechnologies/nulu-compaction": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-output-retention": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-session-projection": "workspace:^",
    "@worldapptechnologies/nulu-session-projection-cache": "workspace:^",
    "@worldapptechnologies/nulu-session-query": "workspace:^",
    "@worldapptechnologies/nulu-session-title": "workspace:^",
    "@worldapptechnologies/nulu-spill": "workspace:^",
    "@worldapptechnologies/nulu-system-prompt": "workspace:^",
    "@worldapptechnologies/nulu-typert-protocol": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@worldapptechnologies/nulu-spill": {
      "optional": true
    },
    "@worldapptechnologies/nulu-session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/cordis-plugin-include": "workspace:^",
    "@worldapptechnologies/cordis-plugin-loader": "workspace:^",
    "@worldapptechnologies/nulu-agent": "workspace:^",
    "@worldapptechnologies/nulu-compaction": "workspace:^",
    "@worldapptechnologies/nulu-fs-local": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-output-retention": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-session-projection": "workspace:^",
    "@worldapptechnologies/nulu-session-projection-cache": "workspace:^",
    "@worldapptechnologies/nulu-session-query": "workspace:^",
    "@worldapptechnologies/nulu-session-query-sqlite": "workspace:^",
    "@worldapptechnologies/nulu-session-title": "workspace:^",
    "@worldapptechnologies/nulu-spill": "workspace:^",
    "@worldapptechnologies/nulu-spill-local": "workspace:^",
    "@worldapptechnologies/nulu-system-prompt": "workspace:^",
    "@worldapptechnologies/nulu-tool-fs": "workspace:^",
    "@worldapptechnologies/nulu-tools": "workspace:^",
    "@worldapptechnologies/nulu-typert-protocol": "workspace:^"
  }
}
