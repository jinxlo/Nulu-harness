{
  "name": "@worldapptechnologies/nulu-time-context",
  "description": "Opt-in durable per-step context with the current time and elapsed time",
  "version": "0.1.6-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldapptechnologies/nulu-harness.git",
    "directory": "packages/context/time-context"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@worldapptechnologies/nulu-util-values": "workspace:^",
    "@worldapptechnologies/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/nulu-agent": "workspace:^",
    "@worldapptechnologies/nulu-invariants": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-session-projection": "workspace:^"
  },
  "devDependencies": {
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/nulu-agent": "workspace:^",
    "@worldapptechnologies/nulu-agent-loop": "workspace:^",
    "@worldapptechnologies/nulu-agent-loop-testkit": "workspace:^",
    "@worldapptechnologies/nulu-app-boot": "workspace:^",
    "@worldapptechnologies/nulu-bash-local": "workspace:^",
    "@worldapptechnologies/nulu-invariants": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-loader-smoke": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-session-checkpoint-policy": "workspace:^",
    "@worldapptechnologies/nulu-session-persistence-jsonl": "workspace:^",
    "@worldapptechnologies/nulu-session-projection": "workspace:^",
    "@worldapptechnologies/nulu-subprocess-local": "workspace:^",
    "@worldapptechnologies/nulu-system-prompt": "workspace:^",
    "@worldapptechnologies/nulu-tools": "workspace:^"
  }
}
