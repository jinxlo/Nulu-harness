{
  "name": "@worldapptechnologies/nulu-credentials-local",
  "description": "File-backed credentials provider ($NULU_HOME/.env under the live process environment) for the Nulu Harness",
  "version": "0.1.6-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldapptechnologies/nulu-harness.git",
    "directory": "packages/credentials/credentials-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@worldapptechnologies/nulu-atomic-write": "workspace:^",
    "@worldapptechnologies/nulu-credentials": "workspace:^",
    "@worldapptechnologies/nulu-launch-environment": "workspace:^",
    "@worldapptechnologies/nulu-home-paths": "workspace:^",
    "@worldapptechnologies/cordis": "workspace:^"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "@worldapptechnologies/schemastery": "workspace:^",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@worldapptechnologies/nulu-atomic-write": "workspace:^",
    "@worldapptechnologies/nulu-credentials": "workspace:^",
    "@worldapptechnologies/nulu-launch-environment": "workspace:^",
    "@worldapptechnologies/nulu-home-paths": "workspace:^",
    "@worldapptechnologies/cordis": "workspace:^"
  }
}
