{
  "name": "@worldapptechnologies/nulu-experimental-agent-team-profile",
  "description": "Experimental profile bundle enabling Agent Teams over nulu-base",
  "version": "1.6.4",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "nulu": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@worldapptechnologies/nulu-experimental-agent-team": "workspace:^",
    "@worldapptechnologies/nulu-experimental-tool-agent-team": "workspace:^"
  },
  "peerDependencies": {
    "@worldapptechnologies/cordis": "workspace:^"
  },
  "devDependencies": {
    "@worldapptechnologies/cordis-plugin-include": "workspace:^",
    "@worldapptechnologies/cordis": "workspace:^",
    "js-yaml": "^4.2.0"
  }
}
