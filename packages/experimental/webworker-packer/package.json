{
  "name": "@worldapptechnologies/nulu-experimental-webworker-packer",
  "description": "Build-time packer for the browser runtime's base VFS image and ordered data-overlay archives",
  "version": "1.6.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldapptechnologies/nulu-harness.git",
    "directory": "packages/experimental/webworker-packer"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "nulu-pack-vfs-image": "./bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/bin.js",
    "bin.js",
    "lib/repository-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@worldapptechnologies/cordis-plugin-include": "workspace:^",
    "@worldapptechnologies/nulu-experimental-webworker-runtime": "workspace:^",
    "@worldapptechnologies/nulu-home-paths": "workspace:^",
    "js-yaml": "^4.2.0",
    "picomatch": "^4.0.4"
  },
  "devDependencies": {
    "@worldapptechnologies/cordis": "workspace:^",
    "@types/js-yaml": "^4.0.9",
    "@types/picomatch": "^3.0.2"
  },
  "peerDependencies": {
    "@worldapptechnologies/cordis": "workspace:^"
  }
}
