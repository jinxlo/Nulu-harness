{
  "name": "@worldapptechnologies/nulu-typert-loader",
  "description": "Loader integration for generated Typert package contributions",
  "version": "1.6.5",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@worldapptechnologies/cordis-plugin-loader": "workspace:^",
    "@worldapptechnologies/nulu-typert-registry": "workspace:^",
    "@worldapptechnologies/cordis": "workspace:^"
  },
  "dependencies": {
    "@worldapptechnologies/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@worldapptechnologies/nulu-app-boot": "workspace:^",
    "@worldapptechnologies/cordis-plugin-loader": "workspace:^",
    "@worldapptechnologies/nulu-typert-registry": "workspace:^",
    "@worldapptechnologies/cordis": "workspace:^",
    "zod": "^4.4.3"
  }
}
