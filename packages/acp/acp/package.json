{
  "name": "@worldapptechnologies/nulu-acp",
  "description": "Automation-only Agent Client Protocol server for driving Nulu Harness agents over JSON-RPC stdio",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldapptechnologies/nulu-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@worldapptechnologies/nulu-brand": "workspace:^",
    "@worldapptechnologies/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/nulu-agent": "workspace:^",
    "@worldapptechnologies/nulu-attachment": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-mcp-client": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-session-persistence": "workspace:^",
    "@worldapptechnologies/nulu-token-meter": "workspace:^",
    "@worldapptechnologies/nulu-user-approval": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@worldapptechnologies/nulu-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/nulu-agent": "workspace:^",
    "@worldapptechnologies/nulu-agent-loop": "workspace:^",
    "@worldapptechnologies/nulu-agent-loop-testkit": "workspace:^",
    "@worldapptechnologies/nulu-attachment": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-mcp-client": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-session-persistence": "workspace:^",
    "@worldapptechnologies/nulu-session-persistence-jsonl": "workspace:^",
    "@worldapptechnologies/nulu-session-projection": "workspace:^",
    "@worldapptechnologies/nulu-token-meter": "workspace:^",
    "@worldapptechnologies/nulu-tools": "workspace:^",
    "@worldapptechnologies/nulu-user-approval": "workspace:^"
  }
}
