{
  "name": "@worldapptechnologies/nulu-subagent-claude-code",
  "description": "One-shot Claude Code subagent provider over the official Agent SDK",
  "version": "1.6.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
