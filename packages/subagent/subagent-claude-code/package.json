    "@worldapptechnologies/nulu-subagent": "workspace:^",
    "@worldapptechnologies/nulu-subprocess": "workspace:^",
    "@worldapptechnologies/nulu-timeout": "workspace:^"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "0.93.0",
    "@worldapptechnologies/nulu-brand": "workspace:^",
    "@worldapptechnologies/schemastery": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@worldapptechnologies/cordis": "workspace:^",
    "@worldapptechnologies/nulu-agent": "workspace:^",
    "@worldapptechnologies/nulu-app-boot": "workspace:^",
    "@worldapptechnologies/nulu-llm": "workspace:^",
    "@worldapptechnologies/nulu-loader-smoke": "workspace:^",
    "@worldapptechnologies/nulu-session": "workspace:^",
    "@worldapptechnologies/nulu-session-checkpoint-policy": "workspace:^",
    "@worldapptechnologies/nulu-session-persistence-jsonl": "workspace:^",
    "@worldapptechnologies/nulu-session-projection": "workspace:^",
    "@worldapptechnologies/nulu-subagent": "workspace:^",
    "@worldapptechnologies/nulu-subagent-codex": "workspace:^",
    "@worldapptechnologies/nulu-subprocess": "workspace:^",
    "@worldapptechnologies/nulu-subprocess-local": "workspace:^",
    "@worldapptechnologies/nulu-timeout": "workspace:^",
    "@worldapptechnologies/nulu-tool-jobs": "workspace:^",
    "@worldapptechnologies/nulu-tool-subagent": "workspace:^",
    "@worldapptechnologies/nulu-tools": "workspace:^"
  }
